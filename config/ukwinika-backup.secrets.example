# =============================================================================
# UKwinika Backup Secrets – v3.2
# Copy to /etc/ukwinika-backup.secrets with mode 600:
#   sudo cp config/ukwinika-backup.secrets.example /etc/ukwinika-backup.secrets
#   sudo chmod 600 /etc/ukwinika-backup.secrets
#
# The default path is /etc/ukwinika-backup.secrets.
# Override at runtime with:  UKW_SECRETS=/custom/path enhanced_automated_backups.sh backup
#
# All sensitive values go HERE — never in ukwinika-backup.conf.
# =============================================================================

# Required – the script aborts immediately if this is unset.
BORG_PASSPHRASE="YourStrongPassphraseHere123!"

# Optional – Slack incoming webhook URL for success and failure notifications.
# The script sends:  "Backup SUCCESS on <hostname>"
#                    "Backup FAILED: <reason> on <hostname>"
# Leave empty to disable Slack notifications.
SLACK_WEBHOOK="https://hooks.slack.com/services/XXXX/YYYY/ZZZZ"

# Optional – email address for success and failure notifications.
# Can also be placed in ukwinika-backup.conf if the address is not sensitive.
# Leave empty to disable email notifications.
EMAIL_TO="admin@example.com"

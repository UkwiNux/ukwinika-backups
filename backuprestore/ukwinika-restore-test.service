# UKwinika Automated Restore Test Service – v1.0
# Source:       backuprestore/ukwinika-restore-test.service
# Installed by: sudo make systemd
# Triggered by: ukwinika-restore-test.timer (monthly on the 15th at 02:30)
# Run manually: sudo systemctl start ukwinika-restore-test.service
#
# Offset from the daily backup timer (02:00) so the two never overlap.
# Uses a separate lock file (/var/lock/ukwinika-restore-test.lock) so it
# never conflicts with a concurrently running backup.

[Unit]
Description=UKwinika Automated Monthly Restore Drill
After=network-online.target
Wants=network-online.target
# Ensure this service starts only after any active backup has completed.
After=ukwinika-backup.service

[Service]
Type=oneshot

Environment="UKW_CONFIG=/etc/ukwinika-backup.conf"
Environment="UKW_SECRETS=/etc/ukwinika-backup.secrets"

ExecStart=/usr/local/bin/ukwinika_automated_restore.sh test

User=root

# Same resource priority as the backup service — this is a background task.
Nice=19
IOSchedulingClass=idle

# Isolated /tmp so temporary files do not leak between runs.
PrivateTmp=true

# Harden: allow writes only to expected paths.
# If RESTORE_TARGET_BASE, RESTORE_DRILL_LOG, or PROMETHEUS_FILE are changed
# in ukwinika-backup.conf, update ReadWritePaths to match.
ProtectSystem=strict
ReadWritePaths=/var/log /var/lock /var/lib/ukwinika /var/lib/prometheus /UKwinikaBackup /tmp
ProtectHome=read-only
NoNewPrivileges=true

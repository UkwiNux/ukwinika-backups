# UKwinika Automated Restore Test Timer – v1.0
# Installed by: sudo make systemd
# Enable and start: sudo systemctl enable --now ukwinika-restore-test.timer
# Check next run:   systemctl list-timers ukwinika-restore-test.timer
#
# Fires on the 15th of each month at 02:30, with up to 30 minutes of random
# jitter. This places the restore drill mid-month, well clear of the daily
# backup timer (02:00 daily) and any month-boundary maintenance windows.
#
# Persistent=true ensures a missed drill (e.g. system was off on the 15th)
# runs as soon as the system comes back online.

[Unit]
Description=Monthly UKwinika Automated Restore Drill Timer

[Timer]
OnCalendar=*-*-15 02:30:00
RandomizedDelaySec=30min
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target


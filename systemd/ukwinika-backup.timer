# UKwinika Daily Backup Timer – v3.2.1
# Installed by: sudo make systemd
# Enable and start: sudo systemctl enable --now ukwinika-backup.timer
# Check next run:   systemctl list-timers ukwinika-backup.timer

[Unit]
Description=Daily UKwinika Backup Timer

[Timer]
# Fire daily at 02:00 with up to 30 minutes of random jitter to spread
# load when multiple hosts share the same backup infrastructure.
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=30min

# If a scheduled run is missed (e.g. the system was off), trigger it
# as soon as the system comes back online.
Persistent=true

AccuracySec=1min

[Install]
WantedBy=timers.target

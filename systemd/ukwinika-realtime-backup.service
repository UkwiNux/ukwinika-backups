# UKwinika Real-Time Backup Monitoring Service – v3.2
# Installed by: sudo make systemd
# Enable and start: sudo systemctl enable --now ukwinika-realtime-backup.service
# View logs:        journalctl -u ukwinika-realtime-backup.service -f

[Unit]
Description=UKwinika Real-Time Backup Monitoring
After=network.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple

Environment="UKW_CONFIG=/etc/ukwinika-backup.conf"
Environment="UKW_SECRETS=/etc/ukwinika-backup.secrets"

ExecStart=/usr/local/bin/enhanced_automated_backups.sh real-time

User=root

# Restart on transient failures but stop after 3 rapid failures within 60 seconds
# to prevent log flooding when the repository is missing or config is broken.
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Run at reduced priority so inotify monitoring does not compete with
# interactive workloads. Child backup processes inherit these settings.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
